{
  "name": "ubridge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "UBridge: secure realtime network runtime for messaging, voice, files, presence and sync.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "find packages -name dist -type d -prune -exec rm -rf {} +",
    "test": "node --test",
    "relay:dev": "node examples/production-relay-test/relay.mjs",
    "demo:prod": "node examples/production-relay-test/demo.mjs",
    "messenger:dev": "npm --workspace @ubridge/messenger run dev",
    "messenger:build": "npm --workspace @ubridge/messenger run build"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.5.13"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
